# 文风管线配置示例：复制为 .env 后填 key（.env 已被 .gitignore 忽略）

# ── 选一个 provider 即可，下面三行的 baseUrl/model 预设会自动套用 ──
# deepseek | qwen | siliconflow | openai | ollama | codebuddy
STYLE_PROVIDER=codebuddy

# 改写模型（复制整行、去掉行首 # 可覆盖 preset 的默认值）
# STYLE_MODEL=deepseek-chat

# 向量模型：留空则检索自动降级为中文二元组 BM25（离线可用，效果略差但零成本）
STYLE_EMBED_MODEL=text-embedding-v3

# 密钥（本地 Ollama 不需要）
# STYLE_API_KEY=sk-xxxxxxxx

# 并发上限，长文批量时防止被封
# STYLE_CONCURRENCY=3
